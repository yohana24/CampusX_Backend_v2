# Must match the registered dbo.Devices.DeviceCode in CampusX
DEVICE_ID=people-counter-lab-01

# Mosquitto broker
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC=smart-campus/telemetry
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=30
MQTT_QOS=1

# Teammate's web_count.py JSON endpoint
CV_JSON_URL=http://127.0.0.1:5000/json
CV_HTTP_TIMEOUT_SECONDS=3

# Publish latest fresh CV snapshot at this interval
PUBLISH_INTERVAL_SECONDS=2
LOG_LEVEL=INFO
