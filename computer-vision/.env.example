# Must match the registered dbo.Devices.DeviceCode in CampusX
DEVICE_ID=people-counter-lab-01

# Default: the NEW head240.pt detector, reading any connected webcam (CV_SOURCE).
#   head   = head240.pt, single "head" class -> top-down / ESP32-CAM 240px (DEFAULT)
#   person = yolov8n.pt, COCO class 0 -> optional full-person frontend mode
# head240.pt is trained on heads seen from above. Front webcams usually show a
# face, so FACE_FALLBACK adds frontal-face detections when head240 finds nothing.
CV_DETECTOR=head
CV_MODEL_PATH=head240.pt
CV_SOURCE=0
CV_FACE_FALLBACK=true

# Local web UI / JSON endpoint (loopback only)
CV_WEB_HOST=127.0.0.1
CV_WEB_PORT=5000
CV_ALWAYS=true
CV_TARGET_FPS=5
CV_IMGSZ=640
CV_ACTIVE_FROM=9
CV_ACTIVE_TO=15

# Detection + tracking tuning (head preset defaults)
CV_CLASS_FILTER=0
CV_CONF_KEEP=0.20
CV_CONF_NEW=0.40
CV_MIN_HITS=3
CV_GRACE=10
CV_SMOOTH=5
CV_MIN_AREA=0.0002
CV_MAX_AREA=0.10
CV_MIN_RATIO=0.5
CV_MAX_RATIO=2.5
CV_SIMULATE_240=true

# Ghost-zone calibration and CSV log
CV_ZONES_FILE=ignore_zones.json
CV_CALIBRATE_SECONDS=30
CV_LOG_FILE=counts.csv
CV_LOG_EVERY=60

# The bridge reads the camera service JSON and publishes people_count telemetry
CV_JSON_URL=http://127.0.0.1:5000/json
CV_HTTP_TIMEOUT_SECONDS=3
PUBLISH_INTERVAL_SECONDS=2

# Mosquitto broker (MQTT contract stays unchanged)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC=smart-campus/telemetry
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=30
MQTT_QOS=1

LOG_LEVEL=INFO
