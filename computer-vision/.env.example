# Must match the registered dbo.Devices.DeviceCode in CampusX
DEVICE_ID=people-counter-lab-01

# Detector preset (the dashboard's default reads any connected front webcam)
#   person = yolov8n.pt, COCO class 0, full frame -> frontal/laptop webcam (DEFAULT)
#   head   = head240.pt, single "head" class, 240px -> overhead / ESP32-CAM
# Any CV_* value below overrides the preset default.
CV_DETECTOR=person
CV_MODEL_PATH=yolov8n.pt
CV_SOURCE=0

# Local web UI / JSON endpoint (loopback only)
CV_WEB_HOST=127.0.0.1
CV_WEB_PORT=5000
CV_ALWAYS=true
CV_TARGET_FPS=5
CV_IMGSZ=640
CV_ACTIVE_FROM=9
CV_ACTIVE_TO=15

# Detection + tracking tuning (person preset defaults)
CV_CLASS_FILTER=0
CV_CONF_KEEP=0.20
CV_CONF_NEW=0.40
CV_MIN_HITS=3
CV_GRACE=10
CV_SMOOTH=5
CV_MIN_AREA=0.02
CV_MAX_AREA=0.85
CV_MIN_RATIO=0.40
CV_MAX_RATIO=3.0
CV_SIMULATE_240=false

# Ghost-zone calibration and CSV log
CV_ZONES_FILE=ignore_zones.json
CV_CALIBRATE_SECONDS=30
CV_LOG_FILE=counts.csv
CV_LOG_EVERY=60

# The bridge reads the camera service JSON and publishes people_count telemetry
CV_JSON_URL=http://127.0.0.1:5000/json
CV_HTTP_TIMEOUT_SECONDS=3
PUBLISH_INTERVAL_SECONDS=2

# Mosquitto broker (MQTT contract stays unchanged)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC=smart-campus/telemetry
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=30
MQTT_QOS=1

LOG_LEVEL=INFO
