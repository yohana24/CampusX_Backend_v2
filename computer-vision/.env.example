# Must match the registered dbo.Devices.DeviceCode in CampusX
DEVICE_ID=people-counter-lab-01

# Default: auto = ONE count that covers EVERY direction.
#   1) head240.pt  -> heads seen from above (top-down / ESP32-CAM 240px)
#   2) face cascade -> faces on a front-facing webcam
#   3) yolov8n.pt class 0 -> full person from the side / behind / any angle
#   head = head240.pt only (top view); person = yolov8n.pt only (any view).
CV_DETECTOR=auto
CV_MODEL_PATH=head240.pt
CV_SOURCE=0

# Fallback detectors used by CV_DETECTOR=auto when head240.pt finds nothing.
CV_FACE_FALLBACK=true
CV_PERSON_FALLBACK=true
CV_PERSON_MODEL=yolov8n.pt
CV_PERSON_CONF=0.25

# Local web UI / JSON endpoint (loopback only).
# One live image with detections: http://127.0.0.1:5000/ (stream endpoint /video).
CV_WEB_HOST=127.0.0.1
CV_WEB_PORT=5000
CV_ALWAYS=true
CV_TARGET_FPS=5
CV_IMGSZ=640
CV_ACTIVE_FROM=9
CV_ACTIVE_TO=15

# Detection + tracking tuning (head preset defaults)
CV_CLASS_FILTER=0
CV_CONF_KEEP=0.20
CV_CONF_NEW=0.40
CV_MIN_HITS=3
CV_GRACE=10
CV_SMOOTH=5
CV_MIN_AREA=0.0002
CV_MAX_AREA=0.10
CV_MIN_RATIO=0.5
CV_MAX_RATIO=2.5
CV_SIMULATE_240=true

# Fallback box limits (different from head boxes)
CV_FACE_MIN_AREA=0.01
CV_FACE_MAX_AREA=0.40
CV_FACE_MIN_RATIO=0.6
CV_FACE_MAX_RATIO=1.8
CV_PERSON_MIN_AREA=0.02
CV_PERSON_MAX_AREA=0.90
CV_PERSON_MIN_RATIO=0.3
CV_PERSON_MAX_RATIO=4.0

# Ghost-zone calibration and CSV log
CV_ZONES_FILE=ignore_zones.json
CV_CALIBRATE_SECONDS=30
CV_LOG_FILE=counts.csv
CV_LOG_EVERY=60

# The bridge reads the camera service JSON and publishes people_count telemetry
CV_JSON_URL=http://127.0.0.1:5000/json
CV_HTTP_TIMEOUT_SECONDS=3
PUBLISH_INTERVAL_SECONDS=2

# Mosquitto broker (MQTT contract stays unchanged)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC=smart-campus/telemetry
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=30
MQTT_QOS=1

LOG_LEVEL=INFO
