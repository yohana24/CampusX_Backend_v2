# Optional SMTP settings for REAL account email verification.
# Do not commit this file with real credentials. Copy the values you need into the ROOT .env.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-app-password
SMTP_FROM=CampusX <no-reply@example.com>
APP_BASE_URL=http://127.0.0.1:3000
