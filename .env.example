# HTTP server — safe default: local machine only
HOST=127.0.0.1
PORT=3000
NODE_ENV=development

# SQL Server / Windows Authentication
SQL_SERVER=DESKTOP-9A5M5CC\SQLEXPRESS
SQL_DATABASE=CampusX
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_TRUSTED_CONNECTION=true
SQL_TRUST_SERVER_CERTIFICATE=true
SQL_ENCRYPT=false
SQL_CONNECTION_TIMEOUT_MS=15000
SQL_REQUEST_TIMEOUT_MS=30000

# MQTT
MQTT_URL=mqtt://localhost:1883
MQTT_TELEMETRY_TOPIC=smart-campus/telemetry
MQTT_DEVICE_TELEMETRY_TOPIC=smart-campus/devices/+/telemetry
MQTT_COMMAND_RESPONSE_TOPIC=smart-campus/devices/+/command-response
MQTT_COMMAND_TOPIC_PREFIX=smart-campus/devices
MQTT_CLIENT_ID=campusx-backend
MQTT_QOS=1

# A non-empty key is strongly recommended before exposing the API to a LAN.
# When HOST is not localhost/127.0.0.1, the server refuses to start without API_KEY.
API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Device online/offline detection
DEVICE_OFFLINE_SECONDS=90
DEVICE_SWEEP_INTERVAL_SECONDS=20

# Telemetry limits
MAX_READINGS_PER_MESSAGE=100
MAX_MQTT_PAYLOAD_BYTES=65536
