# ---------------------------------------------------------------------------
# CampusX Backend v2 — configuration template
# Copy to .env and edit. Never commit the real .env.
# All hostnames, credentials and secrets come from this file/environment.
# ---------------------------------------------------------------------------

# HTTP server — safe default: local machine only
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
# Return HTTP 503 from /api/v1/health when DB or MQTT is down.
STRICT_HEALTH=false
# Public browser origin, e.g. http://127.0.0.1:3000. Same-origin requests are allowed by default.
PUBLIC_ORIGIN=
# Maximum JSON request body size.
JSON_BODY_LIMIT=1mb

# SQL Server — cross-platform default: tedious (pure JS) + SQL authentication.
# This works on Windows, Linux and Raspberry Pi without a native ODBC build.
# SQL_SERVER accepts: host | host\instance | host,port | host\instance,port
SQL_SERVER=localhost
# Optional: set when the SQL Server uses a fixed TCP port (recommended for Linux/Pi).
# SQL_PORT=1433
SQL_DATABASE=CampusX
SQL_USERNAME=campusx_app
SQL_PASSWORD=change-me
SQL_TRUST_SERVER_CERTIFICATE=true
SQL_ENCRYPT=false

# Windows-only legacy fallback: Windows integrated auth via msnodesqlv8.
# Leave false for Linux / Raspberry Pi. If true, SQL_DRIVER and ODBC Driver 18
# are required, and SQL_USERNAME/SQL_PASSWORD are ignored.
SQL_TRUSTED_CONNECTION=false
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_CONNECTION_TIMEOUT_MS=15000
SQL_REQUEST_TIMEOUT_MS=30000
SQL_POOL_MAX=10
SQL_POOL_MIN=0
SQL_POOL_IDLE_TIMEOUT_MS=30000
SQL_RETRY_COOLDOWN_MS=2000

# MQTT — firmware contract topics must stay unchanged
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TELEMETRY_TOPIC=smart-campus/telemetry
MQTT_DEVICE_TELEMETRY_TOPIC=smart-campus/devices/+/telemetry
MQTT_COMMAND_RESPONSE_TOPIC=smart-campus/devices/+/command-response
MQTT_COMMAND_TOPIC_PREFIX=smart-campus/devices
# ${process.pid}, ${hostname} and ${random} are expanded by the server.
MQTT_CLIENT_ID=campusx-backend-${process.pid}-${random}
MQTT_QOS=1
MQTT_CONNECT_TIMEOUT_MS=10000
MQTT_RECONNECT_PERIOD_MS=3000
MQTT_PUBLISH_TIMEOUT_MS=10000
MQTT_WAIT_FOR_CONNECT_MS=5000

# Optional command-type allowlist. Empty = accept any registered type.
COMMAND_TYPES=

# CORS + optional API key. A non-local HOST requires a non-empty API_KEY.
API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Device online/offline detection
DEVICE_OFFLINE_SECONDS=90
DEVICE_SWEEP_INTERVAL_SECONDS=20

# Telemetry limits and timestamp sanity bounds
MAX_READINGS_PER_MESSAGE=100
MAX_MQTT_PAYLOAD_BYTES=65536
TELEMETRY_MAX_FUTURE_SECONDS=300
TELEMETRY_MAX_PAST_SECONDS=2592000

# Graceful shutdown timeouts
HTTP_SHUTDOWN_TIMEOUT_MS=5000
MQTT_SHUTDOWN_TIMEOUT_MS=5000
FORCE_EXIT_TIMEOUT_MS=15000

# Dashboard authentication — generate with scripts/setup-dashboard-auth.ps1
DASHBOARD_USERNAME=your-operator-name
DASHBOARD_PASSWORD_HASH=<salt-hex>:<scrypt-hash-hex>
DASHBOARD_SESSION_SECRET=<at-least-32-random-characters>
DASHBOARD_SESSION_HOURS=8
DASHBOARD_COOKIE_SECURE=false
# Public signup at /register.html. Set false to close it; existing accounts still work.
DASHBOARD_REGISTRATION_ENABLED=true
# Administrator account selection. If both are empty, the bootstrap/first account is promoted when no admin exists.
DASHBOARD_ADMIN_USERNAME=
DASHBOARD_ADMIN_EMAIL=

# Computer Vision process controls (Windows host)
CAMPUSX_CV_DIR=
CAMPUSX_POWERSHELL_EXE=powershell.exe
CAMPUSX_POWERSHELL_EXECUTION_POLICY=RemoteSigned
CV_WEB_HOST=127.0.0.1
CV_WEB_PORT=5000

# Optional smoke-test credentials (never store the real password in .env.example)
CAMPUSX_SMOKE_USERNAME=
CAMPUSX_SMOKE_PASSWORD=
